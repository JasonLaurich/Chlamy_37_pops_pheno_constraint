                            z.y = predict(fit, newdata = data.frame(z.x = x.vals)))

pf.ids <- par.res.1 %>% distinct(rep.ID) %>% mutate(pareto.opt = "Y")

df.filt <- df.filt %>%
  left_join(pf.ids, by = "rep.ID") %>%
  mutate(pareto.opt = if_else(is.na(pareto.opt), "N", pareto.opt))

