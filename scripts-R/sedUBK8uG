df.filt %>% {
  bind_rows(arrange(., desc(z.y)) %>% slice_head(n = 3),
            arrange(., z.y)       %>% slice_head(n = 3),
            arrange(., desc(z.x)) %>% slice_head(n = 3),
            arrange(., z.x)       %>% slice_head(n = 3))
