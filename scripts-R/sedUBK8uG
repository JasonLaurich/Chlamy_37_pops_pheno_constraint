###### Polygonal empty space analysis (Li et al 2019) ######

x.max <- max(df.filt$z.x); y.max <- max(df.filt$z.y)

par.res.1 <- par.res.1 %>% arrange(z.x)

poly <- par.res.1[, c("z.x", "z.y")] %>% add_row(z.x = x.max, z.y = y.max)

a.emp <- polyarea(poly$z.x, poly$z.y)

null.df <- data.frame(a.emp.n = numeric(), n.PF = numeric(), stringsAsFactors = FALSE)

for (i in 1:1000) {
  
  shuffled.df <- df.filt %>%
    
    mutate(z.x.sim = sample(df.filt$z.x, replace = FALSE),
           z.y.sim = sample(df.filt$z.y, replace = FALSE))
  
  par.res.n <- par_frt(shuffled.df, xvar = "z.x.sim", yvar = "z.y.sim") %>% arrange(z.x.sim)
  
  x.max.n <- max(shuffled.df$z.x.sim); y.max.n <- max(shuffled.df$z.y.sim)
  
  poly.n <- par.res.n[, c("z.x.sim", "z.y.sim")] %>% add_row(z.x.sim = x.max.n, z.y.sim = y.max.n)
  
  null.df <- rbind(null.df, data.frame(a.emp.n = polyarea(poly.n$z.x.sim, poly.n$z.y.sim),
                                       n.PF = nrow(par.res.n)))
  
}

mean(null.df$a.emp.n >= a.emp) # P 0.826

